---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import data from '../data/demos.json';

const whatsappUrl =
  'https://wa.me/51936479891?text=Hola%2C%20quiero%20agendar%20una%20llamada%20de%2030%20minutos%20con%20Hive%20Soluciones.';

// To add a project, add an entry to src/data/demos.json. Each project becomes one slide.
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/**/*.{png,webp,jpg}', { eager: true });

const demos = data.demos.map((demo) => ({
  ...demo,
  shots: demo.shots.map((shot) => ({ ...shot, image: images[`../assets/${shot.source}`]?.default })),
}));
---

<section class="sec alt" id="demos" aria-labelledby="t-demos">
  <div class="wrap">
    <div class="sec-head">
      <h2 id="t-demos" class="heading-2">Sistemas que ya funcionan.</h2>
      <p class="lead sec-sub">
        Todavía no tenemos clientes que citar. Lo que sí tenemos son estas demos, de rubros distintos, que puedes recorrer aquí o abrir en vivo.
      </p>
    </div>

    <div class="carousel" data-carousel role="region" aria-roledescription="carrusel" aria-label="Proyectos">
      <div class="car-bar">
        <div class="car-dots" role="group" aria-label="Elegir proyecto">
          {
            demos.map((demo, i) => (
              <button type="button" class="dot" data-dot={i} aria-label={`Ir a ${demo.name}`} aria-current={i === 0 ? 'true' : undefined}>
                <span class="dot-hex" aria-hidden="true"></span>
              </button>
            ))
          }
        </div>
        <p class="caption-1 car-count" aria-live="polite" data-count>
          1 de {demos.length}
        </p>
        <div class="car-arrows">
          <button type="button" class="arrow" data-prev aria-label="Proyecto anterior" disabled>
            <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <button type="button" class="arrow" data-next aria-label="Proyecto siguiente">
            <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"><path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </div>
      </div>

      <div class="track" data-track>
        {
          demos.map((demo, i) => (
            <article
              class="slide"
              data-slide
              data-id={demo.id}
              role="group"
              aria-roledescription="diapositiva"
              aria-label={`${i + 1} de ${demos.length}: ${demo.name}`}
            >
              <div class="slide-media">
                <div class="shot-main" data-stack>
                  {demo.shots.map((shot, n) => (
                    <figure
                      class="shot"
                      data-shot={n}
                      data-label={shot.label}
                      data-caption={shot.caption}
                      style={`--pos: ${n}`}
                      aria-hidden={n === 0 ? undefined : 'true'}
                      inert={n !== 0}
                    >
                      {shot.image && (
                        <Image
                          src={shot.image}
                          alt={shot.alt}
                          widths={[960, 1280, 1600, 1920]}
                          sizes="(min-width: 1280px) 1152px, 100vw"
                          format="webp"
                          quality={85}
                          loading="lazy"
                        />
                      )}
                    </figure>
                  ))}
                </div>

                <div class="shot-ctl">
                  <p class="shot-cap" aria-live="polite">
                    <span class="caption-1 shot-name" data-shot-name>
                      {demo.shots[0].label} · 1 de {demo.shots.length}
                    </span>
                    <span class="caption-1" data-shot-caption>{demo.shots[0].caption}</span>
                  </p>
                  <div class="car-arrows">
                    <button type="button" class="arrow" data-shot-prev aria-label={`Pantalla anterior de ${demo.name}`}>
                      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </button>
                    <button type="button" class="arrow" data-shot-next aria-label={`Pantalla siguiente de ${demo.name}`}>
                      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"><path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </button>
                  </div>
                </div>
              </div>

              <div class="slide-info">
                <div class="info-head">
                  <h3 class="heading-3">{demo.name}</h3>
                  <p class="body-3 demo-lead">{demo.lead}</p>
                </div>
                <dl class="ba">
                  <div>
                    <dt class="caption-1">Antes</dt>
                    <dd class="body-3">{demo.before}</dd>
                  </div>
                  <div class="ba-after">
                    <dt class="caption-1">Ahora</dt>
                    <dd class="body-3">{demo.after}</dd>
                  </div>
                </dl>
                <div class="info-act">
                  <a class="demo-link" href={demo.url} target="_blank" rel="noopener noreferrer">
                    Probar la demo de {demo.name.toLowerCase()}
                    <span class="sr-only"> (se abre en una pestaña nueva)</span>
                  </a>
                  <p class="caption-1 demo-meta">{demo.meta}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <p class="demos-cta">
      <span class="body-3">¿Quieres uno así para tu negocio?</span>
      <a class="text-link" href={whatsappUrl}>Cuéntanos qué necesitas por WhatsApp</a>
    </p>
  </div>
</section>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const count = root.querySelector<HTMLElement>('[data-count]');
    if (!track || !slides.length) return;

    const last = slides.length - 1;
    let active = 0;

    const setActive = (index: number) => {
      const changed = index !== active;
      active = index;
      slides.forEach((slide, i) => slide.toggleAttribute('inert', i !== index));
      dots.forEach((dot, i) => {
        if (i === index) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === last;
      if (count) count.textContent = `${index + 1} de ${slides.length}`;
      if (changed) window.dispatchEvent(new CustomEvent('hive:slide', { detail: index }));
    };

    const go = (index: number) => {
      const target = Math.max(0, Math.min(last, index));
      track.scrollTo({ left: target * track.clientWidth, behavior: reduced ? 'auto' : 'smooth' });
    };

    let frame = 0;
    track.addEventListener('scroll', () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const index = Math.round(track.scrollLeft / track.clientWidth);
        if (index !== active) setActive(Math.max(0, Math.min(last, index)));
      });
    });

    prev?.addEventListener('click', () => go(active - 1));
    next?.addEventListener('click', () => go(active + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));

    root.querySelector('.car-bar')?.addEventListener('keydown', (event) => {
      const key = (event as KeyboardEvent).key;
      if (key === 'ArrowRight') go(active + 1);
      else if (key === 'ArrowLeft') go(active - 1);
    });

    window.addEventListener('resize', () => track.scrollTo({ left: active * track.clientWidth, behavior: 'auto' }));

    // Screens inside a project: a stack of cards. The top card slides out to the side and goes
    // to the back (or the back card comes forward when going backwards).
    slides.forEach((slide) => {
      const cards = Array.from(slide.querySelectorAll<HTMLElement>('[data-shot]'));
      const total = cards.length;
      const name = slide.querySelector<HTMLElement>('[data-shot-name]');
      const caption = slide.querySelector<HTMLElement>('[data-shot-caption]');
      const nextBtn = slide.querySelector<HTMLButtonElement>('[data-shot-next]');
      const prevBtn = slide.querySelector<HTMLButtonElement>('[data-shot-prev]');
      let current = 0;
      let busy = false;
      if (total < 2) {
        nextBtn?.setAttribute('hidden', '');
        prevBtn?.setAttribute('hidden', '');
        return;
      }

      const posOf = (i: number) => (i - current + total) % total;
      const apply = () => {
        cards.forEach((card, i) => {
          const pos = posOf(i);
          card.style.setProperty('--pos', String(pos));
          card.toggleAttribute('inert', pos !== 0);
          if (pos === 0) card.removeAttribute('aria-hidden');
          else card.setAttribute('aria-hidden', 'true');
        });
        const top = cards[current];
        if (name) name.textContent = `${top.dataset.label} · ${current + 1} de ${total}`;
        if (caption) caption.textContent = top.dataset.caption ?? '';
      };

      const snapshot = (el: HTMLElement) => {
        const cs = getComputedStyle(el);
        return { transform: cs.transform, opacity: cs.opacity, filter: cs.filter, zIndex: cs.zIndex };
      };

      const step = (dir: 1 | -1) => {
        if (busy) return;
        const mover = dir === 1 ? cards[current] : cards[(current - 1 + total) % total];
        const from = snapshot(mover);
        mover.classList.add('fly');
        current = (current + dir + total) % total;
        apply();
        if (reduced || !mover.animate) {
          mover.classList.remove('fly');
          return;
        }
        const to = snapshot(mover);
        const side = 'translateX(52%) rotate(5deg)';
        busy = true;
        // While it travels sideways it stays above the pile; it changes layer at the half-way point.
        mover.style.zIndex = dir === 1 ? '200' : from.zIndex;
        const anim = mover.animate(
          [
            { transform: from.transform, opacity: from.opacity, filter: from.filter, offset: 0 },
            { transform: side, opacity: 1, filter: 'brightness(1)', offset: 0.42 },
            { transform: to.transform, opacity: to.opacity, filter: to.filter, offset: 1 },
          ],
          { duration: 760, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
        );
        window.setTimeout(() => {
          mover.style.zIndex = dir === 1 ? '' : '200';
        }, 300);
        const done = () => {
          mover.classList.remove('fly');
          mover.style.zIndex = '';
          busy = false;
        };
        anim.onfinish = done;
        anim.oncancel = done;
        window.dispatchEvent(new CustomEvent('hive:shot', { detail: cards[current] }));
      };

      nextBtn?.addEventListener('click', () => step(1));
      prevBtn?.addEventListener('click', () => step(-1));
      cards.forEach((card) => card.addEventListener('click', () => {
        if (card === cards[current]) step(1);
      }));
    });

    // A link elsewhere on the page can ask for a project by id.
    window.addEventListener('hive:demo', (event) => {
      const id = (event as CustomEvent<string>).detail;
      const index = slides.findIndex((slide) => slide.dataset.id === id);
      if (index >= 0) go(index);
    });

    setActive(0);
  });
</script>
